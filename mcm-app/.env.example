# Environment variables loaded by Expo CLI
# Rename this file to `.env.local` and fill in your credentials.

# Firebase configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-db-url
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional proxy used when fetching calendar files
EXPO_PUBLIC_CORS_PROXY_URL=

# Google Sign-In OAuth (obtener en console.cloud.google.com)
# Web Client ID: usado en todas las plataformas para validar tokens
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# iOS Client ID: solo necesario en builds iOS (EAS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Sentry — crash reporting (opcional)
# Sin DSN la app no reporta NADA: Sentry queda apagado y todo funciona igual.
# El DSN es público por diseño (va dentro del bundle), no es un secreto.
EXPO_PUBLIC_SENTRY_DSN=

# Modo verificación: reporta también en desarrollo y manda un evento "ping" al
# arrancar, para comprobar de una vez que el DSN funciona. Quitar después.
# EXPO_PUBLIC_SENTRY_DEBUG=1

# Solo para el BUILD (subida de source maps). No son variables de runtime y no
# llevan prefijo EXPO_PUBLIC_. En EAS se configuran como secrets del proyecto.
# SENTRY_ORG=mcmespana
# SENTRY_PROJECT=mcm-app
# SENTRY_AUTH_TOKEN=  (secreto — NUNCA commitear; crear en Sentry → Auth Tokens)

# Aptabase — analítica de uso (opcional)
# Sin clave la app no manda NINGÚN evento. La región va dentro de la propia
# clave: A-EU-... son los servidores europeos. No guarda identificadores
# persistentes de dispositivo ni de usuario.
EXPO_PUBLIC_APTABASE_KEY=
# Solo si algún día se autoaloja (claves A-SH-...)
# EXPO_PUBLIC_APTABASE_HOST=
