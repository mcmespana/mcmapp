{
  "expo": {
    "name": "MCM App",
    "slug": "mcm-app",
    "version": "2.1.0",
    "runtimeVersion": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcmapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.familiaconsolacion.mcmapp",
      "infoPlist": {
        "CFBundleDisplayName": "MCM App",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["webcal"],
        "NSLocationWhenInUseUsageDescription": "La app puede usar tu ubicación para habilitar funciones basadas en ubicación cuando estén disponibles (por ejemplo, mostrar información relevante cerca de ti).",
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "MCM Playlist",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.mcmespana.mcmapp.playlist"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.mcmespana.mcmapp.playlist",
            "UTTypeDescription": "MCM Playlist",
            "UTTypeConformsTo": ["public.data", "public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["mcm"],
              "public.mime-type": ["application/octet-stream"]
            }
          }
        ]
      },
      "appleTeamId": "5P53S6QB23",
      "associatedDomains": [
        "applinks:mcm.expo.app",
        "applinks:comunica.movimientoconsolacion.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mcmespana.mcmapp",
      "blockedPermissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [{ "scheme": "mcmapp" }]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.mcm"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.mcm"
            }
          ]
        },
        {
          "autoVerify": true,
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "https",
              "host": "mcm.expo.app",
              "pathPrefix": "/playlist"
            },
            {
              "scheme": "https",
              "host": "mcm.expo.app",
              "pathPrefix": "/coro"
            }
          ]
        },
        {
          "autoVerify": true,
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "https",
              "host": "comunica.movimientoconsolacion.com",
              "pathPrefix": "/ap"
            },
            {
              "scheme": "https",
              "host": "comunica.movimientoconsolacion.com",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "comunica.movimientoconsolacion.com",
              "pathPrefix": "/area-privada"
            },
            {
              "scheme": "https",
              "host": "comunica.movimientoconsolacion.com",
              "pathPrefix": "/actividades"
            },
            {
              "scheme": "https",
              "host": "comunica.movimientoconsolacion.com",
              "path": "/"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#253883",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-asset",
      "./plugins/withNotificationServiceExtension",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Carismochito",
            "ios": "./assets/app-icons/carismochito.png",
            "android": {
              "foregroundImage": "./assets/app-icons/carismochito-foreground.png",
              "backgroundColor": "#A3BD31"
            }
          }
        ]
      ],
      ["expo-build-properties"],
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "MCM App usa la cámara para escanear los códigos QR de playlists y sesiones de coro, y para hacer fotos de títulos y documentos en tu área privada.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "MCM App usa NFC para leer tarjetas y pegatinas del movimiento.",
          "includeNdefEntitlement": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "MCM App usa Face ID para proteger el acceso a tu área privada."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MCM App usa Face ID para proteger el acceso a tu área privada."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MCM App usa tus fotos para subir títulos, certificados y documentos a tu área privada.",
          "cameraPermission": "MCM App usa la cámara para escanear los códigos QR de playlists y sesiones de coro, y para hacer fotos de títulos y documentos en tu área privada.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa9f2d3a-b74a-4169-bad4-e851015e30c6",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "MCMNotificationService",
                  "bundleIdentifier": "com.familiaconsolacion.mcmapp.MCMNotificationService"
                }
              ]
            }
          }
        }
      }
    },
    "updates": {
      "url": "https://u.expo.dev/aa9f2d3a-b74a-4169-bad4-e851015e30c6",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
