+  /// Point size every icon is normalised to. `UITabBarItem` draws its image at
+  /// the image's natural point size (pixels / scale) and never resizes it, so
+  /// the point size is entirely decided by how the `UIImage` was decoded.
+  private static let iconPointSize: CGFloat = 24
+
+  /// Reinterprets an image's scale so it always measures `iconPointSize`
+  /// points, whatever pixel density the file happens to be.
+  ///
+  /// 0.2.1 already passes React Native's asset scale through, which fixes the
+  /// common case. This stays as a belt-and-braces guard for when that scale is
+  /// missing or wrong (0 falls back to 1 for file URLs, which draws a @3x asset
+  /// at 72pt — three times too big, overlapping the labels). Deriving the scale
+  /// from the pixel width holds in every case, as long as every icon is drawn
+  /// for a 24pt box — which `scripts/generate-tab-icons.js` guarantees.
+  private static func normalisedToIconBox(_ image: UIImage) -> UIImage {
+    guard let cgImage = image.cgImage, cgImage.width > 0 else { return image }
+    let scale = CGFloat(cgImage.width) / iconPointSize
+    return UIImage(
+      cgImage: cgImage,
+      scale: scale,
+      orientation: image.imageOrientation
+    )
+  }
