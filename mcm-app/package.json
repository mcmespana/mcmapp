{
  "name": "mcm-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,md}'",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "eas:build": "npx rimraf .agent .agents && cross-env GIT_CLONE_PROTECTION_ACTIVE=false npx eas-cli@latest build",
    "eas:build:ios": "npx rimraf .agent .agents && cross-env GIT_CLONE_PROTECTION_ACTIVE=false npx eas-cli@latest build -p ios",
    "eas:build:android": "npx rimraf .agent .agents && cross-env GIT_CLONE_PROTECTION_ACTIVE=false npx eas-cli@latest build -p android",
    "icons:tabs": "node scripts/generate-tab-icons.js",
    "icons:alt": "node scripts/generate-alt-icons.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/config": "^57.0.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@sentry/react-native": "~7.11.0",
    "chordsheetjs": "^15.6.1",
    "expo": "^57.0.9",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-insights": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-native-compact-tabs": "^0.2.0",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.17.0",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-reorderable-list": "^0.18.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~57.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "opentype.js": "^2.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "react-native-calendars": {
      "react-native-safe-area-context": "~5.6.0"
    },
    "react-test-renderer": "19.2.3",
    "unrs-resolver": "1.11.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-confetti-cannon"
        ]
      }
    }
  }
}
